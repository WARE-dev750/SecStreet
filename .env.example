# Supabase — create a project at https://supabase.com
# Settings → API → Project URL and service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Cloudflare — not needed here; wrangler login stores it
# GitHub OAuth — create an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI provider (optional). Leave unset to use the mock.
SECSTREET_AI_ENDPOINT=
SECSTREET_AI_MODEL=
SECSTREET_AI_KEY=
